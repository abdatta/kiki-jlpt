    {
      "id": "set-02-20260525T213201Z-fztc4b-convo-02",
      "number": 2,
      "title": "At the Apartment Door",
      "scene": "Two friends meet at an apartment entrance.",
      "sampleContext": "They are polite and calm at the door.",
      "text": [
        {
          "speaker": "Speaker 1",
          "tags": [
            "polite",
            "slow"
          ],
          "japanese": "こんにちは。ここが私のアパートです。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "curious",
            "slow"
          ],
          "japanese": "こんにちは。玄関はどこですか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "friendly",
            "slow"
          ],
          "japanese": "あちらです。このドアを開けてください。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "apologetic",
            "slow"
          ],
          "japanese": "すみません、鍵はありますか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "calm",
            "slow"
          ],
          "japanese": "はい、かばんに入れました。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "gentle",
            "slow"
          ],
          "japanese": "ありがとうございます。失礼します。"
        }
      ],
      "listeningQuestions": [
        "Where are the speakers?",
        "What does Speaker 2 ask about first?",
        "Which door does Speaker 1 tell him to open?",
        "Where is the key?",
        "What polite phrase does Speaker 2 say at the end?"
      ],
      "answerKey": [
        "They are at Speaker 1's apartment.",
        "He asks where the entrance is.",
        "She tells him to open this door.",
        "It is in her bag.",
        "He says, 'Excuse me for entering' / 'Shitsurei shimasu.'"
      ],
      "englishTranslation": [
        {
          "speaker": "Speaker 1",
          "english": "Hello. This is my apartment."
        },
        {
          "speaker": "Speaker 2",
          "english": "Hello. Where is the entrance?"
        },
        {
          "speaker": "Speaker 1",
          "english": "It is that way. Please open this door."
        },
        {
          "speaker": "Speaker 2",
          "english": "Excuse me, do you have the key?"
        },
        {
          "speaker": "Speaker 1",
          "english": "Yes, I put it in my bag."
        },
        {
          "speaker": "Speaker 2",
          "english": "Thank you very much. Excuse me."
        }
      ],
