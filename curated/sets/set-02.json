    {
      "id": "set-02-20260525T213201Z-fztc4b-convo-03",
      "number": 3,
      "title": "In the Room",
      "scene": "Two people talk about things in a room.",
      "sampleContext": "They speak gently while looking around the room.",
      "text": [
        {
          "speaker": "Speaker 1",
          "tags": [
            "friendly",
            "slow"
          ],
          "japanese": "この部屋は新しいです。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "curious",
            "slow"
          ],
          "japanese": "いいですね。机はどこですか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "calm",
            "slow"
          ],
          "japanese": "机は窓の隣です。テーブルはあそこです。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "curious",
            "slow"
          ],
          "japanese": "ベッドは大きいですか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "soft",
            "slow"
          ],
          "japanese": "いいえ、小さいです。でも、いいベッドです。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "friendly",
            "slow"
          ],
          "japanese": "窓を開けてもいいですか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "polite",
            "slow"
          ],
          "japanese": "はい、どうぞ。"
        }
      ],
      "listeningQuestions": [
        "What is new?",
        "Where is the desk?",
        "Where is the table?",
        "Is the bed big?",
        "What does Speaker 2 want to open?"
      ],
      "answerKey": [
        "The room is new.",
        "It is next to the window.",
        "It is over there.",
        "No, it is small, but it is good.",
        "He wants to open the window."
      ],
      "englishTranslation": [
        {
          "speaker": "Speaker 1",
          "english": "This room is new."
        },
        {
          "speaker": "Speaker 2",
          "english": "That's nice. Where is the desk?"
        },
        {
          "speaker": "Speaker 1",
          "english": "The desk is next to the window. The table is over there."
        },
        {
          "speaker": "Speaker 2",
          "english": "Is the bed big?"
        },
        {
          "speaker": "Speaker 1",
          "english": "No, it is small. But it is a good bed."
        },
        {
          "speaker": "Speaker 2",
          "english": "May I open the window?"
        },
        {
          "speaker": "Speaker 1",
          "english": "Yes, please."
        }
