    {
      "id": "set-02-20260525T213201Z-fztc4b-convo-01",
      "number": 1,
      "title": "Good Morning at Home",
      "scene": "Two family members talk in the morning at home.",
      "sampleContext": "They sound sleepy but friendly before breakfast.",
      "text": [
        {
          "speaker": "Speaker 1",
          "tags": [
            "sleepy",
            "friendly",
            "slow"
          ],
          "japanese": "おはようございます。今朝、七時に起きました。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "gentle",
            "slow"
          ],
          "japanese": "おはようございます。私は六時に起きました。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "curious",
            "slow"
          ],
          "japanese": "朝御飯を食べますか。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "calm",
            "slow"
          ],
          "japanese": "はい、食べます。お母さんも来ますか。"
        },
        {
          "speaker": "Speaker 1",
          "tags": [
            "soft",
            "slow"
          ],
          "japanese": "はい、母はもう起きました。"
        },
        {
          "speaker": "Speaker 2",
          "tags": [
            "friendly",
            "slow"
          ],
          "japanese": "では、朝御飯を食べましょう。"
        }
      ],
      "listeningQuestions": [
        "What time did Speaker 1 get up this morning?",
        "What time did Speaker 2 get up?",
        "What does Speaker 1 ask about?",
        "Has Speaker 1's mother already gotten up?",
        "What do they decide to do?"
      ],
      "answerKey": [
        "She got up at seven o'clock.",
        "He got up at six o'clock.",
        "She asks whether they will eat breakfast.",
        "Yes, her mother has already gotten up.",
        "They decide to eat breakfast."
      ],
      "englishTranslation": [
        {
          "speaker": "Speaker 1",
          "english": "Good morning. This morning, I got up at seven."
        },
        {
          "speaker": "Speaker 2",
          "english": "Good morning. I got up at six."
        },
        {
          "speaker": "Speaker 1",
          "english": "Will you eat breakfast?"
        },
        {
          "speaker": "Speaker 2",
          "english": "Yes, I will. Will your mother come too?"
        },
        {
          "speaker": "Speaker 1",
          "english": "Yes, my mother has already gotten up."
        },
        {
          "speaker": "Speaker 2",
          "english": "Then, let's eat breakfast."
        }
      ],
