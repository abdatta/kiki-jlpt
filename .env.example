GEMINI_API_KEY=your_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Set to true to exercise the workflow UI without calling Gemini TTS.
MOCK_TTS_AUDIO=false
# Optional: fail a specific conversation number while MOCK_TTS_AUDIO=true.
MOCK_TTS_FAIL_AT=
CODEX_AUTH_SESSION_PATH=../codex-auth/sessions/session.json
CODEX_CLIENT_VERSION=0.0.0
API_PORT=8787
VITE_LISTENING_UNLOCK_RATIO=0.5
VITE_LEVEL_MASTERY_RATIO=0.9
